# Copy to apps/web/.env.local. Same Clerk application as apps/admin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# services/api base URL, called server-side with the learner's session token
API_URL=http://localhost:8000
# Garden dashboard data: api (default; dev falls back to sample data if the API is down) | mock
GARDEN_DATA_SOURCE=api
