{
    "api_schema": {
        "content_type": "application/json",
        "method": "POST",
        "request_body_schema": {
            "description": "Arguments for give_hint",
            "properties": {
                "conversation_id": {
                    "dynamic_variable": "system__conversation_id",
                    "type": "string"
                },
                "problem_id": {
                    "description": "The problem ID returned by fetch_question.",
                    "type": "string"
                }
            },
            "required": [
                "problem_id",
                "conversation_id"
            ],
            "type": "object"
        },
        "request_headers": {
            "X-SG-Tool-Token": {
                "variable_name": "secret__sg_tool_token"
            }
        },
        "url": "https://api-dev.skillgarden.invalid/v1/agent-tools/give_hint"
    },
    "description": "Get the next hint for the coding problem the candidate is stuck on. Hints come in three levels and the backend gives them in order. Calling it records that the candidate was helped, so what they solve afterwards on this problem counts as assisted. Give the hint in your own words, once.",
    "disable_interruptions": false,
    "dynamic_variables": {
        "dynamic_variable_placeholders": {
            "secret__sg_tool_token": "test-token"
        }
    },
    "force_pre_tool_speech": false,
    "name": "give_hint",
    "response_timeout_secs": 8,
    "type": "webhook"
}
