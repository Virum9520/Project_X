# ─── Skill Garden environment template ───────────────────────────────
# Copy to `.env` (never commit it). Python services read this file via
# pydantic-settings; Next.js apps read apps/<app>/.env.local.

ENVIRONMENT=local            # local | test | dev | prod
LOG_LEVEL=INFO

# ── Data ──
# Tiger Cloud: use the service connection string, swapping the scheme to
# postgresql+asyncpg:// and keeping ?ssl=require.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skill_garden
# Optional locally (leave empty without Redis). Railway: ${{Redis.REDIS_URL}}
REDIS_URL=
# Curriculum YAML root; empty means the repo's curriculum/ directory.
CURRICULUM_DIR=

# ── Object storage (MinIO locally, Cloudflare R2 in hosted envs) ──
# R2: S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# Largest accepted document upload in bytes (default 25 MiB)
MAX_UPLOAD_BYTES=26214400
# No MinIO/Docker? Keep objects on disk instead (local/test only): OBJECT_STORE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=skill-garden-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto

# ── Jobs ── leave empty locally to use Hatchet's embedded engine
HATCHET_CLIENT_TOKEN=

# ── Providers ──
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Character -> agent ID JSON, printed by `uv run sg-agents ids` after `sg-agents sync`
ELEVENLABS_AGENT_IDS={}
# Voice Sanjaya narrates the weekly recap with (blank: recaps are text-only)
SANJAYA_VOICE_ID=
# Signs server-tool tokens (POST /v1/sessions). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AGENT_TOOL_TOKEN_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
E2B_API_KEY=
# Models: OpenRouter slugs, comma-separated fallbacks; embeddings must stay 1536-dim (schema).
LLM_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
LLM_FALLBACK_MODELS=openai/gpt-4o-mini
# Evidence pipeline (C11): post-call judge, fast live micro-judge, demo-profile accounts
JUDGE_MODEL=anthropic/claude-sonnet-4.5
MICRO_JUDGE_MODEL=openai/gpt-4o-mini
MICRO_JUDGE_TIMEOUT_SECONDS=4
DEMO_ACCOUNT_EMAILS=
EMBEDDING_MODEL=text-embedding-3-small
# Monthly spend caps (USD) enforced by budget holds
LEARNER_MONTHLY_BUDGET_USD=7.50
DEVELOPER_MONTHLY_BUDGET_USD=25
OWNER_ASSISTANT_MONTHLY_BUDGET_USD=10
# Owner console "Call now": approved developer test destinations (comma-separated; "web" or a
# verified E.164 test number), cooldown between test calls, and the longest allowed test call.
CALL_NOW_APPROVED_TARGETS=web
CALL_NOW_COOLDOWN_SECONDS=60
CALL_NOW_MAX_DURATION_SECONDS=300

# ── Bhima accountability calls (C18) ──
BHIMA_CONSENT_VERSION=bhima-calls-v1
# Local-time quiet window: scheduled calls inside it are cancelled, never delayed
BHIMA_QUIET_START=21:30
BHIMA_QUIET_END=08:00
BHIMA_RING_TIMEOUT_SECONDS=45
BHIMA_LATE_GRACE_SECONDS=1200
BHIMA_MAX_CONCURRENT_CALLS=5
BHIMA_COST_PER_MINUTE_USD=0.12
# Web Push (VAPID) for the incoming-call notification: `npx web-push generate-vapid-keys`
# Set on the API/worker (Railway). The public key reaches the browser through
# GET /v1/accountability/config, so apps/web needs no NEXT_PUBLIC_ variable. Without keys the
# call still rings in the open app (poll fallback) but not as a push notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# ── Auth (Clerk: one application for web and admin) ──
# Frontend API URL, e.g. https://<slug>.clerk.accounts.dev (Dashboard → API keys → Frontend API URL).
# Session JWTs are verified against <CLERK_ISSUER>/.well-known/jwks.json.
CLERK_ISSUER=
# Same secret key as the Next apps; the API uses it to read verified email and MFA state.
CLERK_SECRET_KEY=
# Optional: origins allowed as the token `azp` (defaults to CORS_ORIGINS)
CLERK_AUTHORIZED_PARTIES=
# Comma-separated emails allowed into the owner console (server-side check)
ADMIN_OWNER_EMAILS=
# Browser origins allowed to send admin mutations (CSRF origin check)
ADMIN_ORIGINS=http://localhost:3001
# db (default) | memory: where grants, audit log and users/profiles live
IDENTITY_BACKEND=db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional regex for Vercel preview origins (dev environment only), e.g.
# https://skill-garden-(web|admin)-[a-z0-9-]+-<vercel-team-slug>\.vercel\.app
CORS_ORIGIN_REGEX=

# ── Owner assistant / MCP gateway (C22), all optional ──
# ElevenLabs hosted MCP (OAuth): the access token the owner granted, kept server-side only.
ELEVENLABS_MCP_URL=
ELEVENLABS_MCP_ACCESS_TOKEN=
# Tiger MCP sidecar (HTTP) connected as the read-only `sg_mcp_readonly` role (analytics.* only).
TIGER_MCP_URL=
TIGER_MCP_TOKEN=
TIGER_MCP_SERVICE_ID=
# Model slug for the assistant (default: LLM_DEFAULT_MODEL) and per-question limits
OWNER_ASSISTANT_MODEL=
OWNER_ASSISTANT_MAX_ROWS=200
OWNER_ASSISTANT_TURN_HOLD_USD=0.15

# ── Observability (C23), all optional: unset means the integration is a no-op ──
# Sentry error reporting for api + worker (PII scrubbed before send).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# OpenTelemetry traces over OTLP/HTTP (base URL; /v1/traces is appended). Headers: "k=v,k2=v2".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLE_RATIO=0.1
# Next apps (set in each Vercel project; the DSN is public by design).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
